FROM node:20-alpine
WORKDIR /app

# Set SSL environment variables for build stage
ARG NODE_TLS_REJECT_UNAUTHORIZED=0
ENV NODE_TLS_REJECT_UNAUTHORIZED=${NODE_TLS_REJECT_UNAUTHORIZED}

# Use HTTP repositories for Alpine to avoid SSL issues
RUN sed -i 's/https/http/g' /etc/apk/repositories && \
    apk update && \
    apk add --no-cache ca-certificates

# Copy package files
COPY package.json package-lock.json* ./

# Install ALL dependencies (including devDependencies) since express is needed
RUN npm config set strict-ssl false && \
    (npm ci --legacy-peer-deps || npm install --legacy-peer-deps)

# Copy server code
COPY server.js ./

# Expose ports
EXPOSE 8081
EXPOSE 8200/tcp
EXPOSE 1900/udp

# Start the server
CMD ["node", "server.js"]

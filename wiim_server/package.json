{
    "name": "wiim_server",
    "version": "0.0.2",
    "private": true,
    "scripts": {
        "serve": "node server.js",
        "docker:build": "docker image inspect wiim_ui >/dev/null 2>&1 && docker image rm wiim_ui && docker build -t wiim_ui -f dockerfile.latest . || docker build -t wiim_ui -f dockerfile.latest .",
        "docker:build:arm64": "docker image inspect wiim_ui >/dev/null 2>&1 && docker image rm wiim_ui && docker build -t wiim_ui -f dockerfile.arm64 . || docker build -t wiim_ui -f dockerfile.arm64 .",
        "docker:run": "docker run -d --rm --name wiim_service -p 127.0.0.1:8081:8081 wiim_ui"
    },
    "dependencies": {
        "ip": "^2.0.1",
        "node-ssdp": "^4.0.1",
        "socket.io": "^4.5.1",
        "upnp-client": "^0.0.1"
    },
    "devDependencies": {
        "cheerio": "^1.0.0-rc.12",
        "express": "^5.1.0",
        "upnp-device-client": "^1.0.2",
        "xml2js": "^0.6.2"
    },
    "overrides": {
        "ip": "^2.0.1"
    },
    "eslintConfig": {
        "root": true,
        "env": {
            "node": true
        },
        "extends": [
            "plugin:vue/vue3-essential",
            "eslint:recommended"
        ],
        "parserOptions": {
            "parser": "@babel/eslint-parser"
        },
        "rules": {}
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead",
        "not ie 11"
    ]
}
